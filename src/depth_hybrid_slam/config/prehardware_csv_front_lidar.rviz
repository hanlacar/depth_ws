Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/TF
      Enabled: true
      Name: TF
      Show Axes: true
      Show Arrows: true
      Show Names: true
      Value: true
    - Alpha: 0.48
      Buffer Length: 1
      Class: rviz_default_plugins/Path
      Color: 255; 210; 0
      Enabled: true
      Line Style: Lines
      Line Width: 0.24
      Name: ACTIVE CSV ROUTE (YELLOW)
      Pose Style: None
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/route/reference_path
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: A=CYAN SOLID / B=MAGENTA DASHED
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/csv_only/full_network
      Value: true
    - Class: rviz_default_plugins/PointStamped
      Color: 255; 255; 0
      Enabled: true
      History Length: 1
      Name: Follower Target
      Radius: 0.35
      Topic:
        Depth: 5
        Reliability Policy: Reliable
        Value: /depth_slam/route/target_point
      Value: true
    - Alpha: 1
      Autocompute Intensity Bounds: true
      Class: rviz_default_plugins/LaserScan
      Color: 255; 255; 255
      Color Transformer: FlatColor
      Decay Time: 0
      Enabled: true
      Name: Front A2M12 Scan
      Position Transformer: XYZ
      Size (Pixels): 4
      Style: Flat Squares
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /front/scan
      Use Fixed Frame: true
      Value: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Steering-aware ROI and Obstacles
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/lidar/roi_markers
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 255; 255; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.05
      Name: LiDAR Local Detour
      Pose Style: None
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/lidar/local_path
      Value: true
    - Class: rviz_default_plugins/Path
      Color: 80; 180; 255
      Enabled: true
      Line Style: Lines
      Line Width: 0.04
      Name: Collision Preview
      Pose Style: None
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/route/collision_preview
      Value: true
    - Class: rviz_default_plugins/Marker
      Enabled: true
      Name: Current Owner and Segment
      Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/runtime/status_marker
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera Lane Road Validation
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /depth_slam/csv_road_validation/overlay
      Value: true
    - Class: rviz_default_plugins/Image
      Enabled: true
      Max Value: 1
      Median window: 5
      Min Value: 0
      Name: Camera Traffic Light Result
      Normalize Range: true
      Topic:
        Depth: 1
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Best Effort
        Value: /camera/traffic_light_rgb/overlay_image
      Value: true
  Enabled: true
  Global Options:
    Background Color: 20; 20; 20
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Angle: 0
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Near Clip Distance: 0.01
      Scale: 10
      Target Frame: map
      X: 28
      Y: 30
Window Geometry:
  Height: 900
  Width: 1440
