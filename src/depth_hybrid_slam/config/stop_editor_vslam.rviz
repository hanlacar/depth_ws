Panels:
  - Class: rviz_common/Displays
    Name: Displays
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Alpha: 0.25
      Cell Size: 1
      Class: rviz_default_plugins/Grid
      Color: 120; 120; 120
      Enabled: true
      Name: Ground Grid
      Plane: XY
      Plane Cell Count: 30
      Reference Frame: <Fixed Frame>
    - Alpha: 0.75
      Class: rviz_default_plugins/Map
      Color Scheme: map
      Draw Behind: true
      Enabled: true
      Name: RTAB-Map Occupancy Map
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/map
      Update Topic:
        Depth: 10
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/map_updates
      Use Timestamp: false
    - Alpha: 0.65
      Class: rtabmap_rviz_plugins/MapCloud
      Cloud decimation: 2
      Cloud from scan: false
      Cloud max depth (m): 8
      Cloud min depth (m): 0.2
      Cloud voxel size (m): 0.04
      Color Transformer: RGB8
      Download graph: true
      Download map: true
      Download namespace: /rtabmap/rtabmap
      Enabled: true
      Name: Saved VSLAM Map Cloud
      Size (Pixels): 2
      Style: Points
      Topic:
        Depth: 2
        Durability Policy: Volatile
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /rtabmap/mapData
      Use Fixed Frame: true
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Full 7463-Row Route Network and Case Highlight
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/stop_editor/network
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: Mode 1-11 Route Overlay
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/stop_editor/mode_markers
    - Class: rviz_default_plugins/MarkerArray
      Enabled: true
      Name: STOP and Selected Waypoint Markers
      Topic:
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
        Value: /depth_slam/stop_editor/markers
    - Class: rviz_default_plugins/TF
      Enabled: false
      Frame Timeout: 15
      Name: Vehicle TF
      Show Arrows: true
      Show Axes: true
      Show Names: true
  Enabled: true
  Global Options:
    Background Color: 25; 25; 25
    Fixed Frame: map
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/PublishPoint
      Single click: true
      Topic:
        Value: /clicked_point
  Transformation:
    Current:
      Class: rviz_default_plugins/TF
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 85
      Focal Point:
        X: 16
        Y: 37
        Z: 0
Window Geometry:
  Height: 960
  Width: 1536
